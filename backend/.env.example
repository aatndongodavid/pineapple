# ==============================================================================
# PINEAPPLE OS 3.0 — CONFIGURATION BACKEND (.env.example)
# ==============================================================================

# --- APPLICATION & ENVIRONNEMENT ---
APP_NAME="Pineapple OS"
ENVIRONMENT=development         # 'development', 'staging', ou 'production'
DEBUG=True
PORT=8000

# --- BASE DE DONNÉES POSTGRESQL (Multi-Tenant) ---
DATABASE_URL=postgresql+asyncpg://pineapple_user:pineapple_password@localhost:5432/pineapple_db
# Optionnel : Réplique de lecture pour charge élevée en production
# READ_REPLICA_DB_URL=postgresql+asyncpg://pineapple_read_user:password@replica-host:5432/pineapple_db

# --- CACHE REDIS & WEBSOCKET PUB/SUB ---
REDIS_URL=redis://localhost:6379/0

# --- SÉCURITÉ & AUTHENTIFICATION (JWT) ---
# Clé secrète principale (générer avec: openssl rand -hex 32)
JWT_SECRET_KEY=votre_cle_secrete_principale_tres_longue_et_aleatoire_32bytes
# Optionnel : Clé précédente pour rotation sans déconnexion des utilisateurs
JWT_SECRET_KEY_PREVIOUS=ancienne_cle_secrete_en_cours_de_rotation
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SÉCURITÉ ÉLECTORALE & ANONYMAT ---
# Poivre secret pour le hachage irréversible des bulletins de vote
ELECTION_PEPPER_SECRET=votre_poivre_electoral_immuable_secret_998877

# --- GESTION DES SECRETS EN PRODUCTION (AWS) ---
# Si renseigné, l'application tente de charger les secrets depuis AWS Secrets Manager
# AWS_SECRETS_NAME=pineapple/production/secrets
# AWS_REGION=eu-west-3

# --- STOCKAGE OBJET (AWS S3) ---
AWS_S3_BUCKET_NAME=pineapple-campus-media-bucket
AWS_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLE

# --- PASSERELLE SMS (CANAL SMS & MULTI-FACTEUR) ---
# Fournisseur : 'twilio', 'infobip', ou 'mock' pour le développement
SMS_PROVIDER=mock
SMS_SENDER_ID=Pineapple
# Configuration Twilio (si SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Configuration Infobip (si SMS_PROVIDER=infobip)
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com

# --- DOUBLE AUTHENTIFICATION (MFA TOTP) ---
MFA_ISSUER="Pineapple OS"

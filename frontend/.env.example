# ==============================================================================
# PINEAPPLE OS 3.0 — CONFIGURATION FRONTEND PWA (.env.example)
# ==============================================================================

# URL de l'API Backend Pineapple (remplacer par l'URL de prod en déploiement)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# URL du canal WebSocket temps réel pour la messagerie et les élections
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# Clé publique Google Maps Platform (si utilisée pour le covoiturage)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyExampleKeyForMapsPlatform

# Langue par défaut de l'interface ('fr' ou 'en')
VITE_DEFAULT_LANGUAGE=fr

---
import siteConfig from '../../site.config.json';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-amber-500 flex items-center justify-center font-bold text-slate-950 text-lg">
            🍍
          </div>
          <span class="font-extrabold text-xl text-white">Pineapple OS</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {isFr ? siteConfig.tagline_fr : siteConfig.tagline_en}
        </p>
        <p class="text-xs text-slate-500">
          📍 Yaoundé & Douala, Cameroun
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="font-bold text-white text-base mb-4">{isFr ? 'Produit & Solution' : 'Product & Solution'}</h3>
        <ul class="space-y-2 text-xs">
          <li><a href={isFr ? '/fr/#fonctionnalites' : '/en/#features'} class="hover:text-amber-400 transition-colors">{isFr ? 'Fonctionnalités' : 'Features'}</a></li>
          <li><a href={isFr ? '/fr/securite/' : '/en/security/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Sécurité & Données' : 'Security & Data'}</a></li>
          <li><a href={isFr ? '/fr/tarifs/' : '/en/pricing/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Tarification XAF' : 'XAF Pricing'}</a></li>
          <li><a href={isFr ? '/fr/etudiants/' : '/en/students/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Espace Étudiants' : 'Student Portal'}</a></li>
          <li><a href={isFr ? '/fr/demo/' : '/en/demo/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Démo Interactive' : 'Interactive Demo'}</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Resources -->
      <div>
        <h3 class="font-bold text-white text-base mb-4">{isFr ? 'Ressources & Kit Vente' : 'Resources & Sales Kit'}</h3>
        <ul class="space-y-2 text-xs">
          <li><a href={isFr ? '/fr/a-propos/' : '/en/about/'} class="hover:text-amber-400 transition-colors">{isFr ? 'À propos de Pineapple' : 'About Pineapple'}</a></li>
          <li><a href={isFr ? '/fr/faq/' : '/en/faq/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Foire Aux Questions (FAQ)' : 'Frequently Asked Questions'}</a></li>
          <li><a href={isFr ? '/fr/blog/' : '/en/blog/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Articles & Guides' : 'Articles & Guides'}</a></li>
          <li><a href={isFr ? '/fr/mentions-legales/' : '/en/legal/'} class="hover:text-amber-400 transition-colors">{isFr ? 'Mentions Légales & Confidentialité' : 'Legal Notice & Privacy'}</a></li>
        </ul>
      </div>

      <!-- Col 4: Direct Contact -->
      <div>
        <h3 class="font-bold text-white text-base mb-4">{isFr ? 'Contact & Équipe' : 'Contact & Support'}</h3>
        <p class="text-xs mb-3">
          {isFr ? 'Une question ou besoin d\'une présentation directe pour votre conseil d\'administration ?' : 'Questions or need a presentation for your board of directors?'}
        </p>
        <a
          href={`mailto:${siteConfig.contactEmail}`}
          class="inline-block text-xs font-semibold text-amber-400 hover:underline mb-2"
        >
          ✉️ {siteConfig.contactEmail}
        </a>
        <br />
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(isFr ? siteConfig.whatsappDefaultMessage_fr : siteConfig.whatsappDefaultMessage_en)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 hover:underline"
        >
          💬 WhatsApp Direct: +{siteConfig.whatsappNumber}
        </a>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Pineapple OS. {isFr ? 'Tous droits réservés. Écosystème éducatif souverain.' : 'All rights reserved. Sovereign educational ecosystem.'}</p>
      <div class="flex gap-4">
        <a href="/fr/" class="hover:text-slate-300">Français (FR)</a>
        <span>•</span>
        <a href="/en/" class="hover:text-slate-300">English (EN)</a>
      </div>
    </div>
  </div>
</footer>

---
import siteConfig from '../../site.config.json';

interface Props {
  lang?: 'fr' | 'en';
  alternateUrlFr?: string;
  alternateUrlEn?: string;
}

const { lang = 'fr', alternateUrlFr = '/fr/', alternateUrlEn = '/en/' } = Astro.props;

const isFr = lang === 'fr';

const navLinks = isFr ? [
  { href: '/fr/#fonctionnalites', label: 'Fonctionnalités' },
  { href: '/fr/securite/', label: 'Sécurité & Données' },
  { href: '/fr/tarifs/', label: 'Tarifs' },
  { href: '/fr/etudiants/', label: 'Étudiants & Familles' },
  { href: '/fr/a-propos/', label: 'À propos' },
  { href: '/fr/faq/', label: 'FAQ' },
  { href: '/fr/blog/', label: 'Blog' },
] : [
  { href: '/en/#features', label: 'Features' },
  { href: '/en/security/', label: 'Security & Data' },
  { href: '/en/pricing/', label: 'Pricing' },
  { href: '/en/students/', label: 'Students & Families' },
  { href: '/en/about/', label: 'About' },
  { href: '/en/faq/', label: 'FAQ' },
  { href: '/en/blog/', label: 'Blog' },
];
---

<header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={isFr ? '/fr/' : '/en/'} class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center font-bold text-slate-950 text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
        🍍
      </div>
      <div>
        <span class="font-extrabold text-xl tracking-tight text-white group-hover:text-amber-400 transition-colors">Pineapple OS</span>
        <span class="block text-xs text-slate-400 font-medium">{isFr ? 'Gestion Académique' : 'Academic OS'}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-amber-400 transition-colors">{link.label}</a>
      ))}
    </nav>

    <!-- Language Switcher & CTA -->
    <div class="flex items-center gap-4">
      <!-- Language Switcher -->
      <div class="flex items-center bg-slate-800 rounded-lg p-1 border border-slate-700 text-xs font-semibold">
        <a
          href={alternateUrlFr}
          class={`px-2.5 py-1 rounded-md transition-colors ${isFr ? 'bg-amber-500 text-slate-950 font-bold shadow' : 'text-slate-400 hover:text-white'}`}
          aria-label="Version Française"
        >
          FR
        </a>
        <a
          href={alternateUrlEn}
          class={`px-2.5 py-1 rounded-md transition-colors ${!isFr ? 'bg-amber-500 text-slate-950 font-bold shadow' : 'text-slate-400 hover:text-white'}`}
          aria-label="English Version"
        >
          EN
        </a>
      </div>

      <!-- Demo CTA -->
      <a
        href={isFr ? '/fr/demo/' : '/en/demo/'}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 rounded-lg font-bold text-sm bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 hover:from-amber-400 hover:to-amber-500 transition-all shadow-md hover:shadow-amber-500/20"
      >
        {isFr ? 'Demander une démo' : 'Request a Demo'}
      </a>
    </div>
  </div>
</header>

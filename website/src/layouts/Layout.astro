---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import siteConfig from '../../site.config.json';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  alternateUrlFr?: string;
  alternateUrlEn?: string;
}

const {
  title,
  description,
  lang = 'fr',
  alternateUrlFr = '/fr/',
  alternateUrlEn = '/en/'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.baseUrl);
const frUrl = new URL(alternateUrlFr, siteConfig.baseUrl);
const enUrl = new URL(alternateUrlEn, siteConfig.baseUrl);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | {siteConfig.siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags (Gate W6) -->
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteConfig.siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteConfig.siteName}`} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col antialiased">
    <Header lang={lang} alternateUrlFr={alternateUrlFr} alternateUrlEn={alternateUrlEn} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
  </body>
</html>

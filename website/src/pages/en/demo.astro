---
import Layout from '../../layouts/Layout.astro';
import DemoRequestForm from '../../components/DemoRequestForm.astro';
---

<Layout
  title="Request a Free Demo"
  description="Schedule a customized presentation of Pineapple OS or test our live demo environment directly."
  lang="en"
  alternateUrlFr="/fr/demo/"
  alternateUrlEn="/en/demo/"
>
  <section class="py-16 bg-slate-900 text-white border-b border-slate-800 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold tracking-tight mb-4">See Pineapple OS in Action</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        Fill in the form below to schedule a guided 20-minute presentation with an expert or try the live sandbox right now.
      </p>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left: Demo Request Form -->
      <div class="lg:col-span-7">
        <DemoRequestForm lang="en" />
      </div>

      <!-- Right: Direct Instant Sandbox Link & Expectations -->
      <div class="lg:col-span-5 space-y-8">
        <div class="bg-slate-900 text-white p-8 rounded-2xl border border-slate-800 shadow-xl">
          <span class="text-xs uppercase font-extrabold text-amber-400 tracking-wider mb-2 block">Instant Access</span>
          <h2 class="text-xl font-bold mb-4">👀 Prefer testing it yourself?</h2>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Explore our fictional sandbox ("Établissement Démo Pineapple") pre-loaded with 60 students, 4 programs, 8 lecture halls, and live timetables.
          </p>
          <a
            href="https://demo.pineapple.cm"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full text-center py-3.5 px-6 rounded-xl font-extrabold text-sm bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 hover:from-amber-400 hover:to-amber-500 transition-all shadow-lg"
          >
            👉 Launch Instant Sandbox
          </a>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-md text-slate-700 text-xs space-y-4">
          <h3 class="font-bold text-slate-900 text-sm">📋 What your demo session includes:</h3>
          <ul class="space-y-2">
            <li class="flex items-center gap-2">✓ Review of your current academic management challenges</li>
            <li class="flex items-center gap-2">✓ Role-tailored demonstration for your team (Director, SG, Registrar)</li>
            <li class="flex items-center gap-2">✓ Simulation of your existing student list import</li>
            <li class="flex items-center gap-2">✓ Non-binding XAF pricing quote tailored to your student body</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
